# Dart and Flutter caches, regenerated by `dart pub get` / `flutter pub get`.
# Each package's .dart_tool is about 35 MB; never commit it.
.dart_tool/
build/
.packages

# Python caches from the demo scripts.
__pycache__/
*.pyc

# Screenshots and contact sheets made while rehearsing or checking the demo.
demo/**/shots/
demo/part2/*.png
demo/part1/referral_qr_screen.png

# Built apps and recorded media (also covered by release/ and demo/ ignores).
*.apk
*.aab
*.mp4
*.webm

# Machine-specific settings.
local.properties
*.iml
.idea/
